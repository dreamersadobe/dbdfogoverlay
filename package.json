{
  "name": "game-overlay",
  "version": "2.0.0",
  "description": "Universal in-game overlay for displaying any website on top of your game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build-installer": "electron-builder --win nsis"
  },
  "author": "DBDFogOverlay",
  "license": "MIT",
  "homepage": "https://github.com/marginallix/dbdfogoverlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/marginallix/dbdfogoverlay.git"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {},
  "build": {
    "appId": "com.gameoverlay.app",
    "productName": "Game Overlay",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "overlay.css",
      "overlay.js",
      "error.html",
      "config.json",
      "assets/**"
    ]
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
