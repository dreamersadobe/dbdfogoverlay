{
  "name": "game-overlay",
  "version": "2.2.2",
  "description": "Universal in-game overlay for displaying any website on top of your game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "author": "DBDFogOverlay",
  "license": "MIT",
  "homepage": "https://github.com/dreamersadobe/multioverlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreamersadobe/multioverlay.git"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {},
  "build": {
    "appId": "com.gameoverlay.app",
    "productName": "Game Overlay",
    "publish": null,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Game Overlay",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "differentialPackage": false
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "overlay.css",
      "overlay.js",
      "error.html",
      "config.json",
      "assets/**"
    ]
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
