{
  "name": "dbd-fog-overlay",
  "version": "1.0.0",
  "description": "In-game overlay for Dead by Daylight that displays dbdfog.ru builds",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build-installer": "electron-builder --win nsis"
  },
  "author": "DBDFogOverlay",
  "license": "MIT",
  "homepage": "https://github.com/marginallix/dbdfogoverlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/marginallix/dbdfogoverlay.git"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {},
  "build": {
    "appId": "com.dbdfog.overlay",
    "productName": "DBD Fog Overlay",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "overlay.css",
      "overlay.js",
      "error.html",
      "config.json",
      "assets/**"
    ]
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
